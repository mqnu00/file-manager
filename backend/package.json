{
  "name": "@mqn00/file-manager",
  "version": "3.0.0-beta4",
  "main": "dist/app.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./plugin": {
      "types": "./dist/plugin/types.d.ts",
      "default": "./dist/plugin/types.js"
    },
    "./plugin/frontend": {
      "types": "./dist/plugin/frontend-types.d.ts",
      "default": "./dist/plugin/frontend-types.js"
    }
  },
  "bin": {
    "file-manager": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mqnu00/file-manager.git"
  },
  "keywords": [
    "file-manager",
    "file-management",
    "file-browser",
    "express",
    "vue3",
    "typescript",
    "self-hosted",
    "web-based"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "prepublishOnly": "npm --prefix ../frontend run build && npm run build",
    "lint": "eslint src/ --ext .ts --fix",
    "lint:check": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "js-yaml": "^4.1.1",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.31.17",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/systeminformation": "^3.23.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "axios": "^1.6.8",
    "element-plus": "^2.6.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "pinia": "^2.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  }
}
