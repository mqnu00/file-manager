{
  "name": "@mqn00/file-manager-plugin-file-code-viewer",
  "version": "0.1.2",
  "description": "File Manager 文件查看子插件：代码/纯文本查看与编辑（Monaco Editor，按后缀高亮，可保存）",
  "main": "dist/backend.js",
  "exports": {
    ".": "./dist/backend.js",
    "./frontend": "./dist/frontend.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "build:frontend": "node build.mjs"
  },
  "fileManagerPlugin": {
    "dependsOn": [
      "file-viewer"
    ]
  },
  "peerDependencies": {
    "@mqn00/file-manager": "^3.0.0"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@mqn00/file-manager": "file:../../backend",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mqnu00/file-manager.git",
    "directory": "plugins/file-code-viewer"
  },
  "keywords": [
    "file-manager",
    "file-manager-plugin",
    "viewer",
    "code-editor",
    "monaco"
  ],
  "author": "mqn00",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
