{
  "name": "@mqn00/file-manager-plugin-file-office-viewer",
  "version": "0.1.1",
  "description": "File Manager 文件查看子插件：Office 文档只读预览（PDF 原生预览、docx/xlsx 前端渲染、ppt/doc 后端 LibreOffice 转 PDF）",
  "main": "dist/backend.js",
  "exports": {
    ".": "./dist/backend.js",
    "./frontend": "./dist/frontend.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "build:frontend": "node build.mjs",
    "test": "vitest run"
  },
  "fileManagerPlugin": {
    "dependsOn": [
      "file-viewer"
    ]
  },
  "peerDependencies": {
    "@mqn00/file-manager": "^3.0.0"
  },
  "dependencies": {
    "docx-preview": "^0.3.2",
    "mime-types": "^2.1.35",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@mqn00/file-manager": "file:../../backend",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mqnu00/file-manager.git",
    "directory": "plugins/file-office-viewer"
  },
  "keywords": [
    "file-manager",
    "file-manager-plugin",
    "viewer",
    "office",
    "docx",
    "xlsx",
    "pptx",
    "pdf"
  ],
  "author": "mqn00",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
