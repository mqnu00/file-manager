{
  "name": "@mqn00/file-manager-plugin-compress",
  "version": "0.1.0",
  "description": "File Manager 压缩插件：支持多选文件/文件夹压缩为 zip，可指定输出文件夹（默认当前文件夹），压缩前预检源读取权限与输出目录写入权限，SSE 进度与取消",
  "main": "dist/backend.js",
  "exports": {
    ".": "./dist/backend.js",
    "./frontend": "./dist/frontend.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "build:frontend": "node build.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mqn00/file-manager": "^3.0.0-beta7"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@mqn00/file-manager": "file:../../backend",
    "@types/archiver": "^7.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mqnu00/file-manager.git",
    "directory": "plugins/compress"
  },
  "keywords": [
    "file-manager",
    "file-manager-plugin",
    "compress",
    "zip",
    "archive"
  ],
  "author": "mqn00",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}