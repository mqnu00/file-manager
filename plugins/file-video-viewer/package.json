{
  "name": "@mqn00/file-manager-plugin-file-video-viewer",
  "version": "0.1.2",
  "description": "File Manager 文件查看子插件：视频播放（HTML5 流式播放，Range 支持拖拽/Seek）",
  "main": "dist/backend.js",
  "exports": {
    ".": "./dist/backend.js",
    "./frontend": "./dist/frontend.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "build:frontend": "node build.mjs"
  },
  "fileManagerPlugin": {
    "dependsOn": [
      "file-viewer"
    ]
  },
  "peerDependencies": {
    "@mqn00/file-manager": "^3.0.0"
  },
  "devDependencies": {
    "@mqn00/file-manager": "file:../../backend",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mqnu00/file-manager.git",
    "directory": "plugins/file-video-viewer"
  },
  "keywords": [
    "file-manager",
    "file-manager-plugin",
    "viewer",
    "video",
    "player"
  ],
  "author": "mqn00",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
