{
  "name": "@mqn00/file-manager-plugin-file-viewer",
  "version": "0.1.0",
  "description": "File Manager 插件核心：劫持文件列表单击打开文件，维护查看器注册表并分发到子查看插件，提供公共文件 I/O 后端（read/write/bytes/write-range/token/stream）",
  "main": "dist/backend.js",
  "exports": {
    ".": "./dist/backend.js",
    "./frontend": "./dist/frontend.js",
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node build.mjs",
    "dev": "tsc --watch",
    "build:frontend": "node build.mjs",
    "test": "vitest run"
  },
  "fileManagerPlugin": {
    "frontendPage": "/plugin/file-viewer",
    "config": {
      "extensionMappings": {
        "type": "object",
        "default": {},
        "description": "扩展名→查看器完整映射表（小写后缀、不带点；缺省时使用各查看器注册的默认后缀）"
      }
    }
  },
  "peerDependencies": {
    "@mqn00/file-manager": "^3.0.0-beta7"
  },
  "devDependencies": {
    "@mqn00/file-manager": "file:../../backend",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mqnu00/file-manager.git",
    "directory": "plugins/file-viewer"
  },
  "keywords": [
    "file-manager",
    "file-manager-plugin",
    "viewer",
    "file-viewer"
  ],
  "author": "mqn00",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
